# Database
DATABASE_URL="postgresql://user:password@localhost:5432/predisha?schema=public"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
APP_URL="http://localhost:3000"

# Sports data: demo (development only) or a production adapter name
SPORTS_DATA_PROVIDER="demo"

# football-data.org (set SPORTS_DATA_PROVIDER="football-data" to use live data)
# Get a free token at https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=""
FOOTBALL_DATA_BASE_URL="https://api.football-data.org/v4"

# Admin bootstrap (used only by `npm run db:seed`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Development test accounts (seeded by default outside production)
SEED_DEMO_USERS="true"
SEED_USER_PASSWORD="PredishaTest123!"

# Billing — keep disabled until the provider approves the business model and markets
BILLING_PROVIDER="disabled"
BILLING_LIVE_ENABLED="false"
BILLING_CURRENCY="USD"
BILLING_WEEKLY_AMOUNT_MINOR=""
BILLING_MONTHLY_AMOUNT_MINOR=""
BILLING_WEEKLY_PRICE_ID=""
BILLING_MONTHLY_PRICE_ID=""

# Optional server-side LLM/API credentials (never expose to the client)
OPENCODE_API_KEY=""


# Database
DATABASE_URL="postgresql://user:password@localhost:5432/spotibet?schema=public"

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
APP_URL="http://localhost:3000"

# Sports data: demo (development only) or a production adapter name
SPORTS_DATA_PROVIDER="demo"
# If the live provider fails or returns no fixtures, show demo fixtures temporarily.
# Set to "true" to keep the honest empty state instead.
DISABLE_DEMO_FALLBACK="false"
ALLOW_DEMO_FALLBACK="false"

# football-data.org (set SPORTS_DATA_PROVIDER="football-data" to use live data)
# Get a free token at https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=""
FOOTBALL_DATA_BASE_URL="https://api.football-data.org/v4"

# Public fallback fixture feed with real team badges (shared free key is 123).
THESPORTSDB_API_KEY="123"
# Set to "true" to disable the public fixture fallback.
DISABLE_REAL_FIXTURE_FALLBACK="false"

# Admin bootstrap (used only by `npm run db:seed`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Development test accounts (seeded by default outside production)
SEED_DEMO_USERS="true"
SEED_USER_PASSWORD="SpotibetTest123!"

# Billing - keep disabled until the provider approves the business model and markets
# BILLING_PROVIDER: "disabled" | "settlopay" | "manual"
# "manual" activates subscriptions without a real payment and only runs when
# BILLING_TEST_MODE=true or NODE_ENV is not "production".
BILLING_PROVIDER="disabled"
BILLING_LIVE_ENABLED="false"
BILLING_TEST_MODE="false"
BILLING_CURRENCY="TZS"
BILLING_WEEKLY_AMOUNT_MINOR="2000"
BILLING_MONTHLY_AMOUNT_MINOR="5000"
BILLING_QUARTERLY_AMOUNT_MINOR="12000"

SETTLO_API_KEY=""
SETTLO_BASE_URL="https://api.settlopay.co.tz"
SETTLO_API_VERSION="2026-04-29"
SETTLO_WEBHOOK_SECRET=""
SETTLO_WEBHOOK_URL="https://spotionebet.co.tz/webhooks/settlo"

# Optional server-side LLM/API credentials (never expose to the client)
OPENCODE_API_KEY=""

# NextSMS (bet transaction SMS via https://nextsms.co.tz/api-docs)
NEXTSMS_API_KEY=""
NEXTSMS_BASE_URL="https://messaging-service.co.tz"
NEXTSMS_SENDER_ID="NEXTSMS"

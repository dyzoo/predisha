generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  preferences     UserPreference?
  savedFixtures   SavedFixture[]
  subscription    Subscription?
  auditLogs       AdminAuditLog[]  @relation("ActorLogs")
  predictionSlips PredictionSlip[]
  freePreview     UserFreePreview?

  betWallet        BetWallet?
  betTransactions  BetTransaction[]
  betTickets       BetTicket[]
  betPromoClaims   BetPromoClaim[]
  betGameRounds    BetGameRound[]
  betAviatorBets   BetAviatorBet[]
  adminBetEntries  AdminBetEntry[]
  betPaymentOrders BetPaymentOrder[]
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  timezone        String   @default("UTC")
  locale          String   @default("en")
  favoriteSports  String[] @default([])
  favoriteLeagues String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Sports domain
model Sport {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competitions Competition[]
}

model Competition {
  id         String   @id @default(cuid())
  providerId String?
  name       String
  country    String?
  season     String?
  sportId    String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sport    Sport     @relation(fields: [sportId], references: [id])
  fixtures Fixture[]

  @@index([providerId])
}

model Team {
  id         String   @id @default(cuid())
  providerId String?
  name       String
  shortName  String   @default("")
  color      String   @default("#9CA3AF")
  logoUrl    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  homeFixtures Fixture[] @relation("HomeTeam")
  awayFixtures Fixture[] @relation("AwayTeam")

  @@index([providerId])
}

model Fixture {
  id                    String        @id @default(cuid())
  providerId            String?       @unique
  competitionId         String
  homeTeamId            String
  awayTeamId            String
  kickoffUtc            DateTime
  status                FixtureStatus @default(SCHEDULED)
  homeScore             Int?
  awayScore             Int?
  lastSyncedAt          DateTime      @default(now())
  sourceProvider        String?       @default("unknown")
  sourceFilePath        String?
  sourceRevision        String?
  retrievedAt           DateTime?
  sourceUpdatedAt       DateTime?
  importedAt            DateTime?
  parserVersion         String?
  dataQualityStatus     String?       @default("PENDING")
  isEligibleForTraining Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  competition Competition     @relation(fields: [competitionId], references: [id])
  homeTeam    Team            @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team            @relation("AwayTeam", fields: [awayTeamId], references: [id])
  predictions Prediction[]
  savedBy     SavedFixture[]
  teamStats   TeamMatchStat[]

  @@index([kickoffUtc])
  @@index([status])
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
  ABANDONED
}

model TeamMatchStat {
  id        String   @id @default(cuid())
  fixtureId String
  teamId    String
  key       String
  value     String
  source    String?
  asOf      DateTime @default(now())
  createdAt DateTime @default(now())

  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@index([fixtureId])
}

// Predictions
model ModelVersion {
  id        String   @id @default(cuid())
  name      String
  version   String
  config    Json
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  predictions Prediction[]
}

model Prediction {
  id               String           @id @default(cuid())
  fixtureId        String
  market           String
  modelVersionId   String
  generatedAt      DateTime         @default(now())
  inputDataAsOf    DateTime
  status           PredictionStatus @default(DRAFT)
  dataQualityFlags String[]         @default([])
  structuredFacts  Json
  explanation      String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  fixture      Fixture               @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  modelVersion ModelVersion          @relation(fields: [modelVersionId], references: [id])
  outcomes     PredictionOutcome[]
  evaluation   PredictionEvaluation?

  @@index([fixtureId, status])
}

enum PredictionStatus {
  DRAFT
  PUBLISHED
  STALE
  INVALIDATED
  EVALUATED
}

model PredictionOutcome {
  id           String @id @default(cuid())
  predictionId String
  outcomeKey   String
  probability  Float

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@index([predictionId])
}

model PredictionEvaluation {
  id            String   @id @default(cuid())
  predictionId  String   @unique
  actualOutcome String
  brierScore    Float?
  logLoss       Float?
  evaluatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
}

// Saved user prediction slips. The selections keep a snapshot of the model
// output at build time so later data changes cannot rewrite history.
model PredictionSlip {
  id                  String     @id @default(cuid())
  userId              String
  stake               Float
  currency            String     @default("USD")
  risk                String
  odds                Float?
  oddsSource          String     @default("model-implied")
  impliedCombinedOdds Float
  combinedProbability Float
  potentialReturn     Float
  netProfit           Float
  modelVersion        String?
  dataAsOf            DateTime?
  generatedAt         DateTime   @default(now())
  demo                Boolean    @default(false)
  limited             Boolean    @default(false)
  status              SlipStatus @default(PENDING)
  brierScore          Float?
  settledAt           DateTime?
  createdAt           DateTime   @default(now())

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  selections  PredictionSlipSelection[]
  freePreview UserFreePreview?

  @@index([userId, generatedAt])
  @@index([status])
}

enum SlipStatus {
  PENDING
  WON
  LOST
  VOID
}

model PredictionSlipSelection {
  id              String   @id @default(cuid())
  slipId          String
  fixtureId       String
  competition     String
  homeName        String
  awayName        String
  kickoffUtc      DateTime
  outcomeKey      String
  probability     Float
  impliedOdds     Float
  homeProbability Float
  drawProbability Float
  awayProbability Float
  actualOutcome   String?
  correct         Boolean?
  brierScore      Float?

  slip PredictionSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)

  @@index([slipId])
  @@index([fixtureId])
}

model UserFreePreview {
  id        String   @id @default(cuid())
  userId    String   @unique
  claimedAt DateTime @default(now())
  slipId    String?  @unique

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  slip PredictionSlip? @relation(fields: [slipId], references: [id], onDelete: SetNull)
}

// User interactions
model SavedFixture {
  id        String   @id @default(cuid())
  userId    String
  fixtureId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@unique([userId, fixtureId])
}

// Billing
model SubscriptionPlan {
  id              String       @id @default(cuid())
  name            String
  interval        PlanInterval
  amountMinor     Int
  currency        String       @default("USD")
  features        Json
  providerPriceId String?
  active          Boolean      @default(true)
  dailyLimit      Int?         @default(1)
  weeklyLimit     Int?         @default(5)
  monthlyLimit    Int?         @default(10)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  subscriptions Subscription[]
}

enum PlanInterval {
  WEEKLY
  MONTHLY
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  planId                 String
  providerSubscriptionId String?            @unique
  providerCustomerId     String?
  status                 SubscriptionStatus @default(INACTIVE)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])
  billingEvents BillingEvent[]

  @@index([status])
}

enum SubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

model BillingEvent {
  id              String    @id @default(cuid())
  subscriptionId  String?
  providerEventId String    @unique
  type            String
  processed       Boolean   @default(false)
  processingState String?
  safeMetadata    Json?
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
}

model OutboundProviderLink {
  id         String   @id @default(cuid())
  url        String
  label      String
  disclosure String
  available  Boolean  @default(false)
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  actor User? @relation("ActorLogs", fields: [actorId], references: [id])
}

model SyncJob {
  id         String     @id @default(cuid())
  type       String
  status     SyncStatus @default(PENDING)
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?    @db.Text
  metadata   Json?
  createdAt  DateTime   @default(now())
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

// Betting module. The platform can run in LIVE or SANDBOX mode; mode-specific
// copy and payment behaviour are driven by PlatformSetting below.
model BetWallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  balanceMinor Int      @default(0)
  currency     String   @default("TZS")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions BetTransaction[]
}

model BetTransaction {
  id                String             @id @default(cuid())
  userId            String
  walletId          String
  type              BetTransactionType
  amountMinor       Int
  balanceAfterMinor Int
  reference         String?            @unique
  note              String?
  metadata          Json?
  createdAt         DateTime           @default(now())

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet BetWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([walletId])
}

enum BetTransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_WIN
  BET_CASHOUT
  PROMO_BONUS
  GAME_STAKE
  GAME_WIN
  ADJUSTMENT
}

model BetTicket {
  id                   String          @id @default(cuid())
  userId               String
  code                 String          @unique
  stakeMinor           Int
  totalOdds            Float
  potentialReturnMinor Int
  status               BetTicketStatus @default(OPEN)
  payoutMinor          Int             @default(0)
  cashoutMinor         Int?
  selectionCount       Int
  selections           Json
  placedAt             DateTime        @default(now())
  settledAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, placedAt])
  @@index([status])
}

enum BetTicketStatus {
  OPEN
  WON
  LOST
  VOID
  CASHED_OUT
}

model BetShareCode {
  id         String   @id @default(cuid())
  code       String   @unique
  selections Json
  createdBy  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

model BetPromoClaim {
  id         String   @id @default(cuid())
  userId     String
  promoId    String
  bonusMinor Int
  claimedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, promoId])
}

model BetGameRound {
  id          String        @id @default(cuid())
  userId      String
  game        BetGameType
  stakeMinor  Int
  payoutMinor Int           @default(0)
  status      BetGameStatus @default(OPEN)
  detail      Json
  createdAt   DateTime      @default(now())
  settledAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum BetGameType {
  MINES
  DICE
  ROULETTE
  SLOTS
}

enum BetGameStatus {
  OPEN
  WON
  LOST
}

model BetAviatorBet {
  id          String              @id @default(cuid())
  userId      String
  roundId     String
  slot        Int
  stakeMinor  Int
  autoCashout Float?
  cashedOutAt Float?
  payoutMinor Int                 @default(0)
  status      BetAviatorBetStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  settledAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roundId, slot])
  @@index([roundId])
}

enum BetAviatorBetStatus {
  ACTIVE
  CASHED_OUT
  LOST
}

// Platform-wide key/value settings. The betting mode is stored under
// `bet.mode` with values LIVE or SANDBOX and can be toggled from the admin
// console. Missing rows fall back to the BET_MODE environment variable.
model PlatformSetting {
  key       String   @id
  value     String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin-authored bet slips. An admin selects upcoming fixtures, sets prices,
// assigns a stake and shares the generated code/link with customers.
model AdminBetSlip {
  id                   String              @id @default(cuid())
  code                 String              @unique
  title                String?
  mode                 String              @default("LIVE")
  selections           Json
  totalOdds            Float
  stakeMinor           Int
  potentialReturnMinor Int
  status               AdminBetSlipStatus @default(OPEN)
  freezeReason         String?
  autoFreezeAt         DateTime
  frozenAt             DateTime?
  frozenBy             String?
  createdBy            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  entries AdminBetEntry[]

  @@index([status])
  @@index([autoFreezeAt])
  @@index([createdAt])
}

enum AdminBetSlipStatus {
  OPEN
  FROZEN
  CLOSED
}

// A customer's attempt to take an admin-authored slip. Payment is collected
// with HarakaPay before the entry is marked PAID.
model AdminBetEntry {
  id              String              @id @default(cuid())
  slipId          String
  userId          String?
  phone           String
  stakeMinor      Int
  status          AdminBetEntryStatus @default(PENDING)
  provider        String?
  providerOrderId String?             @unique
  ticketId        String?             @unique
  placementStartedAt DateTime?
  failureReason   String?
  paidAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  slip AdminBetSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([slipId, status])
  @@index([phone])
  @@index([createdAt])
}

enum AdminBetEntryStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

// HarakaPay collection orders for wallet deposits. The webhook resolves the
// order to a user, then credits the betting wallet idempotently.
model BetPaymentOrder {
  id          String    @id @default(cuid())
  userId      String
  kind        String    @default("DEPOSIT")
  amountMinor Int
  currency    String    @default("TZS")
  provider    String
  orderId     String    @unique
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}
